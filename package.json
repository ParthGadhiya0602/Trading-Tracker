{
  "name": "trading-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "NSE market dashboard, alerts, manual trade journal, and reports",
  "type": "commonjs",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env run.js",
    "live": "node --env-file-if-exists=.env run.js --stream --capture",
    "stream": "node --env-file-if-exists=.env run.js --stream",
    "capture": "node --env-file-if-exists=.env run.js --capture",
    "closed": "node --env-file-if-exists=.env run.js --no-tick",
    "prod": "node --env-file=.env backend/server.js",
    "deploy": "cloudflared tunnel --url http://127.0.0.1:8787/",
    "doctor": "node --env-file-if-exists=.env scripts/mongo-doctor.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "mongodb": "^6.9.0"
  }
}
