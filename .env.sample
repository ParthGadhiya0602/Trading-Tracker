# Environment configuration — the only active runtime configuration path.
# Never put secrets in an uploaded or committed file.
#
# Node 24 LTS (24.11+) can load this file directly:   node --env-file=.env run.js
# Or export the vars in your process manager (pm2 env / systemd Environment=).
# Copy to `.env` and fill in. `.env` is gitignored.

# --- Auth (REQUIRED; >= 32 chars — generate: openssl rand -hex 32) ---
AUTH_PASSWORD_PEPPER=

# --- MongoDB Atlas (optional; omit for local file storage) ---
# Prefer the standard (non-SRV) connection string if the host's DNS can't resolve SRV.
MONGO_URI=

# --- Data feed (REQUIRED) — the whole `feed` block as ONE-LINE JSON ---
# Example shape (fill with real values):
# FEED_JSON={"base":"https://HOST","indicesEndpoint":"/...?symbol=","preopenEndpoint":"/...?key=","referer":"/...","warmupPaths":["/","/..."],"stream":{"wsBase":"wss://...","origin":"https://...","indexParam":"index","constituents":{},"levels":{}},"derivatives":{"contractInfoEndpoint":"/REPLACE_WITH_CONTRACT_INFO_ENDPOINT","optionChainEndpoint":"/REPLACE_WITH_OPTION_CHAIN_ENDPOINT","referer":"/REPLACE_WITH_DERIVATIVES_REFERER","enabledSymbols":["NIFTY","BANKNIFTY"]}}
FEED_JSON=

# --- Derivatives ---
DERIVATIVES_ENABLED=0
DERIVATIVES_ALLOW_CLOSED_REVIEW=0
DERIVATIVES_POLL_SECONDS=5
DERIVATIVES_REQUEST_BUDGET_PER_MINUTE=24
DERIVATIVES_IDLE_GRACE_SECONDS=60

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ZoneTrackerAlertBot

# --- LLM analysis (optional; dormant without a key) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
# LLM_ENABLED=false     # force the LLM off even if a key is set

# --- Runtime ---
PORT=8787
HOST=127.0.0.1          # set 0.0.0.0 to accept external connections directly (e.g. EC2 security group)
STREAM_WS=             # 1 to enable the live WebSocket feed
STORE_REFRESH_SECONDS=3 # market-hours background refresh cadence
ALERT_POLL_SECONDS=5     # server-side alert evaluation cadence (min 2)
# ALERTS_NO_TICK=1      # serve UI/APIs without evaluating alerts
# TELEGRAM_DISABLED=1   # disable Telegram polling on this instance
# MARKET_CAPTURE=1      # log market-status transitions + raw samples
# STREAM_CAPTURE=1      # log a bounded sample of raw WSS frames for schema diagnosis
