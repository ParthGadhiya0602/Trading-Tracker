# Environment configuration — the only active runtime configuration path.
# Never put secrets in an uploaded or committed file.
#
# Node 24 LTS (24.11+) can load this file directly:   node --env-file=.env run.js
# Or export the vars in your process manager (pm2 env / systemd Environment=).
# Copy to `.env` and fill in. `.env` is gitignored.

# --- Auth (REQUIRED; >= 32 chars — generate: openssl rand -hex 32) ---
AUTH_PASSWORD_PEPPER=

# --- MongoDB Atlas (optional; omit for local file storage) ---
# Prefer the standard (non-SRV) connection string if the host's DNS can't resolve SRV.
MONGO_URI=

# --- Common market source configuration ---
MARKET_BASE_URL=https://www.nseindia.com
MARKET_STREAM_BASE_URL=wss://streamer.nseindia.com/streams

# --- REST APIs ---
MARKET_INDICES_ENDPOINT=/api/NextApi/apiClient/marketWatchApi?functionName=getIndicesData&symbol=
MARKET_PREOPEN_ENDPOINT=/api/market-data-pre-open?key=
MARKET_REFERER=/market-data/live-equity-market

# --- Index streaming ---
MARKET_INDEX_STREAM_PATH=/indices/high

# --- Index constituent stream paths ---
MARKET_NIFTY50_CONSTITUENTS_PATH=PATH_KEY_FOR_NIFTY50_STOCKS
MARKET_NIFTYNEXT50_CONSTITUENTS_PATH=PATH_KEY_FOR_NEXT50
MARKET_NIFTYMIDCAP50_CONSTITUENTS_PATH=PATH_KEY_FOR_MIDCAP50
MARKET_NIFTYMIDCAP100_CONSTITUENTS_PATH=PATH_KEY_FOR_MIDCAP100

# --- Index level stream paths ---
MARKET_NIFTY50_LEVEL_PATH=PATH_KEY_FOR_NIFTY50_LEVEL
MARKET_NIFTYNEXT50_LEVEL_PATH=PATH_KEY_FOR_NEXT50_LEVEL
MARKET_NIFTYMIDCAP50_LEVEL_PATH=PATH_KEY_FOR_MIDCAP50_LEVEL
MARKET_NIFTYMIDCAP100_LEVEL_PATH=PATH_KEY_FOR_MIDCAP100_LEVEL

# --- Derivatives ---
MARKET_DERIVATIVE_MASTER_QUOTE_ENDPOINT=/api/master-quote
MARKET_DERIVATIVE_STOCK_QUOTE_ENDPOINT=/api/NextApi/apiClient/GetQuoteApi
MARKET_DERIVATIVE_CONTRACT_INFO_ENDPOINT=/api/option-chain-contract-info
MARKET_DERIVATIVE_OPTION_CHAIN_ENDPOINT=/api/option-chain-v3
MARKET_DERIVATIVE_FUTURES_ENDPOINT=/api/liveEquity-derivatives
MARKET_DERIVATIVE_REFERER=/option-chain
MARKET_DERIVATIVE_FUTURES_REFERER=/market-data/equity-derivatives-watch
MARKET_DERIVATIVE_SYMBOLS=NIFTY,NIFTYNXT50,FINNIFTY,BANKNIFTY,MIDCPNIFTY,NIFTYFPI

# --- Commodity derivatives ---
MARKET_COMMODITY_FUTURES_ENDPOINT=/api/liveCommodity-future-contract
MARKET_COMMODITY_OPTION_ENDPOINT=/api/liveCommodity-option-contract
MARKET_COMMODITY_FILTER_ENDPOINT=/api/quotes-commodity-master-filter
MARKET_COMMODITY_DETAIL_ENDPOINT=/api/quotes-commodity-derivatives-main
MARKET_COMMODITY_REFERER=/market-data/commodity-derivatives-watch

# --- Derivative streaming ---
MARKET_DERIVATIVE_STREAM_PATH=/fo

# --- Derivatives ---
DERIVATIVES_ENABLED=0
DERIVATIVES_FUTURES_ENABLED=0
DERIVATIVES_STOCK_OPTIONS_ENABLED=0
DERIVATIVES_COMMODITY_ENABLED=0
DERIVATIVES_ALLOW_CLOSED_REVIEW=0
DERIVATIVES_POLL_SECONDS=5
DERIVATIVES_REQUEST_BUDGET_PER_MINUTE=24
DERIVATIVES_METADATA_BUDGET_PER_MINUTE=12
DERIVATIVES_IDLE_GRACE_SECONDS=60

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ZoneTrackerAlertBot

# --- LLM analysis (optional; dormant without a key) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
# LLM_ENABLED=false     # force the LLM off even if a key is set

# --- Runtime ---
PORT=8787
HOST=127.0.0.1          # set 0.0.0.0 to accept external connections directly (e.g. EC2 security group)
STREAM_WS=             # 1 to enable the live WebSocket feed
STORE_REFRESH_SECONDS=3 # market-hours background refresh cadence
ALERT_POLL_SECONDS=5     # server-side alert evaluation cadence (min 2)
# ALERTS_NO_TICK=1      # serve UI/APIs without evaluating alerts
# TELEGRAM_DISABLED=1   # disable Telegram polling on this instance
# MARKET_CAPTURE=1      # log market-status transitions + raw samples
# STREAM_CAPTURE=1      # log a bounded sample of raw WSS frames for schema diagnosis
