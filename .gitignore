# Secrets & local configuration (keep .env.sample tracked)
.env
.env.*
!.env.sample

# Runtime / generated data
store/*
license.key
logs/

# Local planning / design / spec / data-source docs — ignore all root-level *.md
# EXCEPT the project's kept docs. Agent/skill .md live in subdirs and stay tracked.
/*.md
!/README.md
!/CLAUDE.md
!/AGENTS.md

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Logs
*.log

.impeccable

# Node (not used today, but safe if deps are ever added)
node_modules/
npm-debug.log*
.nvmrc
